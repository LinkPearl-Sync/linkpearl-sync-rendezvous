<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Linkpearl.Rendezvous</RootNamespace>
    <AssemblyName>lprdv</AssemblyName>
    <!-- Un binaire compilé sans -p:Version se dit en développement : la mise à
         jour automatique l'ignore au lieu de le croire en 1.0.0 et de
         l'écraser à la première release plus récente. -->
    <Version>0.0.0-dev</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Déclaré pour que packages.lock.json porte aussi la cible linux-x64 :
         sans elle, la publication autonome de la release ne pourrait pas
         restaurer en mode verrouillé. -->
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MaxMind.Db" Version="5.2.0" />
  </ItemGroup>

  <Import Project="..\build\Protocol.Sources.props" />

</Project>
